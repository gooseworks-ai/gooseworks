{
  "name": "gooseworks",
  "version": "0.4.5",
  "description": "GooseWorks CLI — give your coding agent real data tools",
  "bin": {
    "gooseworks": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "generate:skills": "tsx scripts/generate-skill-files.ts",
    "prepublishOnly": "npm run generate:skills && npm run build && npm test",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts && npm run generate:skills",
    "test:pack": "node scripts/pack-smoke.cjs",
    "build:parts": "tsx scripts/build-kit-parts.ts"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "open": "^7.4.2",
    "ora": "^5.4.1",
    "playwright-core": "1.61.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "0.27.7",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    ".codex-plugin",
    "LICENSE"
  ],
  "keywords": [
    "gooseworks",
    "cli",
    "claude",
    "cursor",
    "ai-agents",
    "data-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gooseworks-ai/gooseworks"
  },
  "homepage": "https://gooseworks.ai",
  "author": "GooseWorks <help@gooseworks.ai>"
}
